kde2d <- read.table("../../output/stats/kde2D_sense_specific_overlap_embeddings_v2.txt")
colnames(kde2d) <- c("From", "vs", "To", "Overlap")
# Escape underscores if you need LaTeX later
kde2d <- kde2d %>%
mutate(across(c(From, To), ~ gsub("_", "\\\\_", ., fixed = TRUE)))
# Define ordering
order <- c(
"1-VIZUALIZE/PICTURE",
"2-THINK/BELIVE",
"3-SUPPOSE/ASSUME",
"4-FALSE\\_PERCEPTION"
)
kde2d <- kde2d %>%
mutate(
From = factor(From, levels = order),
To = factor(To, levels = order)
)
ggplot(kde2d, aes(To, From, fill = Overlap)) +
geom_tile(color = "white") +
geom_text(aes(label = sprintf("%.2f", Overlap)), size = 4) +
scale_fill_gradient(
low = "white",
high = "#2166AC",
limits = c(0, 1)
) +
coord_equal() +
labs(
x = NULL,
y = NULL,
fill = "Overlap"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1)
)
kde2d
